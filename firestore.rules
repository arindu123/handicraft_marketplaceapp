rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function role(value) { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == value; }
    match /users/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.role in ['buyer', 'artisan', 'courier']
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // Role and ownership are immutable from the client.
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'area', 'photoUrl', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100
        && request.resource.data.get('area', '') is string && request.resource.data.get('area', '').size() <= 100
        && request.resource.data.get('photoUrl', '') is string
        && request.resource.data.get('photoUrl', '').size() <= 2048
        && (request.resource.data.get('photoUrl', '') == '' || request.resource.data.photoUrl.matches('https://.*'))
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active is bool;
      allow update: if owner(uid) && role('courier')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryOnline', 'updatedAt'])
        && request.resource.data.deliveryOnline is bool
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && role('courier')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryNotifications', 'updatedAt'])
        && request.resource.data.deliveryNotifications is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /cart/{productId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && role('buyer')
          && request.resource.data.keys().hasOnly(['productId', 'quantity', 'addedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.quantity is int && request.resource.data.quantity > 0
          && request.resource.data.quantity <= get(/databases/$(database)/documents/products/$(productId)).data.stock
          && get(/databases/$(database)/documents/products/$(productId)).data.status == 'active'
          && request.resource.data.addedAt is timestamp;
      }
      match /addresses/{addressId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && role('buyer')
          && request.resource.data.keys().hasAll(['name','address','city','postalCode','country','phone'])
          && request.resource.data.keys().hasOnly(['name','address','city','postalCode','country','phone'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 300
          && request.resource.data.city is string && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 100
          && request.resource.data.postalCode is string && request.resource.data.postalCode.size() > 0 && request.resource.data.postalCode.size() <= 100
          && request.resource.data.country is string && request.resource.data.country.size() > 0 && request.resource.data.country.size() <= 100
          && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 40;
      }
      match /favorites/{productId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && role('buyer')
          && request.resource.data.keys().hasOnly(['productId', 'addedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.addedAt is timestamp
          && get(/databases/$(database)/documents/products/$(productId)).data.status == 'active';
      }
    }
    function validProduct(id) {
      let p = request.resource.data;
      return p.keys().hasOnly(['id','artisanId','name','category','price','currency','description','imageUrls','stock','status','createdAt','lastOrderId'])
        && p.id == id && p.artisanId == request.auth.uid
        && p.name is string && p.name.size() > 0 && p.category is string && p.description is string
        && p.price is number && p.price >= 0 && p.price < 1000000
        && p.currency in ['LKR','USD'] && p.stock is int && p.stock >= 0
        && p.imageUrls is list && p.imageUrls.size() <= 4
        && p.status in ['draft','active','hidden'] && p.createdAt is string;
    }
    match /products/{id} {
      function orderedQuantity(items, index) {
        return index < items.size() && items[index].productId == id ? items[index].quantity : 0;
      }
      function reserveStock() {
        let orderId = request.resource.data.lastOrderId;
        let o = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
        let quantity = orderedQuantity(o.items,0) + orderedQuantity(o.items,1)
          + orderedQuantity(o.items,2) + orderedQuantity(o.items,3);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','lastOrderId'])
          && !exists(/databases/$(database)/documents/orders/$(orderId))
          && o.buyerId == request.auth.uid && o.status == 'pending'
          && o.artisanId == resource.data.artisanId && quantity > 0
          && request.resource.data.stock is int && request.resource.data.stock >= 0
          && request.resource.data.stock == resource.data.stock - quantity;
      }
      allow get: if isAdmin() || signedIn() && (!exists(/databases/$(database)/documents/products/$(id)) || resource.data.status == 'active' || resource.data.artisanId == request.auth.uid);
      allow list: if isAdmin() || signedIn() && (resource.data.status == 'active' || resource.data.artisanId == request.auth.uid);
      allow create: if role('artisan') && validProduct(id);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['active','hidden']) || role('artisan') && resource.data.artisanId == request.auth.uid
        && validProduct(id) && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.currency == resource.data.currency;
      allow update: if role('buyer') && reserveStock();
      allow delete: if role('artisan') && resource.data.artisanId == request.auth.uid;
    }
    function validItem(items, index, artisan) {
      return index >= items.size() || validPresentItem(items[index], artisan);
    }
    function validPresentItem(i, artisan) {
      let p = getAfter(/databases/$(database)/documents/products/$(i.productId)).data;
      return i.keys().hasOnly(['productId','productName','imageUrl','unitPrice','quantity'])
        && p.status == 'active' && p.artisanId == artisan
        && p.currency == request.resource.data.get('currency', 'USD')
        && i.productName == p.name && i.unitPrice == p.price
        && i.quantity is int && i.quantity > 0 && p.stock >= 0
        && p.lastOrderId == request.resource.data.id
        && i.imageUrl == (p.imageUrls.size() > 0 ? p.imageUrls[0] : null);
    }
    function amount(items, index) { return index < items.size() ? items[index].unitPrice * items[index].quantity : 0; }
    function validOrder(id) {
      let o = request.resource.data;
      let subtotal = amount(o.items,0) + amount(o.items,1) + amount(o.items,2) + amount(o.items,3);
      return o.keys().hasOnly(['id','buyerId','artisanId','courierId','items','status','deliveryAddress','paymentMethod','subtotal','deliveryFee','total','createdAt','updatedAt','recipientName','recipientPhone','pickupAddress','pickupName','deliveryInstructions','currency'])
        && o.get('currency', 'USD') in ['LKR','USD']
        && o.get('recipientName', '') is string && o.get('recipientName', '').size() <= 100
        && o.get('recipientPhone', '') is string && o.get('recipientPhone', '').size() <= 40
        && o.get('pickupAddress', '') is string && o.get('pickupAddress', '').size() <= 2000
        && o.get('pickupName', '') is string && o.get('pickupName', '').size() <= 200
        && o.get('deliveryInstructions', '') is string && o.get('deliveryInstructions', '').size() <= 1000
        && o.id == id && o.buyerId == request.auth.uid && o.courierId == null
        && o.status == 'pending' && o.items is list && o.items.size() > 0 && o.items.size() <= 4
        && validItem(o.items,0,o.artisanId) && validItem(o.items,1,o.artisanId)
        && validItem(o.items,2,o.artisanId) && validItem(o.items,3,o.artisanId)
        && o.subtotal == subtotal && o.deliveryFee == (subtotal >= 250 ? 0 : 14)
        && o.total == subtotal + o.deliveryFee
        && o.deliveryAddress is string && o.deliveryAddress.size() > 0
        && o.paymentMethod == 'Cash on delivery' && o.createdAt is string && o.updatedAt == null;
    }
    match /orders/{id} {
      function deliveryActive() {
        return !existsAfter(/databases/$(database)/documents/orders/$(id)/deliveryPlan/current)
          || getAfter(/databases/$(database)/documents/orders/$(id)/deliveryPlan/current).data.outcome == 'active';
      }
      function courierTransition() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return (keys.hasOnly(['status','updatedAt'])
          && ((resource.data.status == 'courierAssigned' && request.resource.data.status == 'pickedUp')
            || (resource.data.status == 'pickedUp' && request.resource.data.status == 'onTheWay')))
          || (keys.hasOnly(['status','updatedAt','deliveryConfirmationCode'])
            && resource.data.status == 'onTheWay' && request.resource.data.status == 'delivered'
            && request.resource.data.deliveryConfirmationCode is string
            && request.resource.data.deliveryConfirmationCode.matches('[0-9]{6}')
            && request.resource.data.deliveryConfirmationCode == get(/databases/$(database)/documents/deliveryConfirmations/$(id)).data.code);
      }
      // Permits reading an unused ID so an idempotent creation transaction can start.
      function availableDelivery() {
        return role('courier') && resource.data.status == 'confirmed' && resource.data.courierId == null;
      }
      allow get: if availableDelivery() || isAdmin() || signedIn() && (!exists(/databases/$(database)/documents/orders/$(id))
        || resource.data.buyerId == request.auth.uid || resource.data.artisanId == request.auth.uid || resource.data.courierId == request.auth.uid);
      allow list: if availableDelivery() || isAdmin() || signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.artisanId == request.auth.uid || resource.data.courierId == request.auth.uid);
      allow create: if role('buyer') && validOrder(id);
      allow update: if availableDelivery()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','courierId','updatedAt'])
        && request.resource.data.courierId == request.auth.uid
        && request.resource.data.status == 'courierAssigned'
        && request.resource.data.updatedAt is string;
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','courierId'])
        && request.resource.data.updatedAt is string
        && ((request.resource.data.status == 'courierAssigned' && resource.data.status in ['confirmed','courierAssigned']
            && get(/databases/$(database)/documents/users/$(request.resource.data.courierId)).data.role == 'courier')
          || (request.resource.data.courierId == resource.data.courierId
            && ((resource.data.status == 'pending' && request.resource.data.status == 'confirmed')
              || (resource.data.status == 'pickedUp' && request.resource.data.status == 'onTheWay')
              || (resource.data.status == 'onTheWay' && request.resource.data.status == 'delivered')))))
        || signedIn()
        && request.resource.data.updatedAt is string
        && ((role('artisan') && resource.data.artisanId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
            && resource.data.status == 'pending' && request.resource.data.status == 'confirmed')
          || (role('courier') && resource.data.courierId == request.auth.uid
            && deliveryActive() && courierTransition()));
      allow delete: if false;
      function deliveryOrder() { return get(/databases/$(database)/documents/orders/$(id)).data; }
      function deliveryReader() {
        return isAdmin() || signedIn() && (deliveryOrder().buyerId == request.auth.uid
          || deliveryOrder().artisanId == request.auth.uid || deliveryOrder().courierId == request.auth.uid);
      }
      function assignedActive() {
        return role('courier') && deliveryOrder().courierId == request.auth.uid
          && deliveryOrder().status in ['courierAssigned','pickedUp','onTheWay'];
      }
      function validAttempt() {
        let d = request.resource.data;
        return d.keys().hasAll(['courierId','outcome','reason','notes','retryAt','createdAt'])
          && d.keys().hasOnly(['courierId','outcome','reason','notes','retryAt','createdAt'])
          && d.courierId == request.auth.uid
          && d.outcome in ['failed','rescheduled','returnRequested']
          && d.reason in ['Customer unavailable','Wrong address','Damaged parcel','Unable to accept delivery','Other']
          && d.notes is string && d.notes.size() <= 1000
          && (d.reason != 'Other' || d.notes.size() > 0)
          && (d.outcome == 'rescheduled' ? (d.retryAt is timestamp && d.retryAt > request.time) : d.retryAt == null)
          && d.createdAt == request.time;
      }
      match /deliveryPlan/{planId} {
        allow read: if deliveryReader();
        allow create: if planId == 'current' && assignedActive() && validAttempt();
        allow update: if planId == 'current' && assignedActive()
          && resource.data.outcome != 'returnRequested'
          && (validAttempt() || (resource.data.outcome in ['failed','rescheduled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outcome','createdAt'])
            && request.resource.data.outcome == 'active'
            && (resource.data.retryAt == null || resource.data.retryAt <= request.time)
            && request.resource.data.createdAt == request.time));
        allow delete: if isAdmin();
      }
      match /deliveryAttempts/{attemptId} {
        allow read: if deliveryReader();
        allow create: if assignedActive() && validAttempt()
          && request.resource.data == getAfter(/databases/$(database)/documents/orders/$(id)/deliveryPlan/current).data;
        allow update, delete: if false;
      }
      match /deliveryProofs/{stage} {
        allow read: if deliveryReader();
        allow create, update: if role('courier') && deliveryOrder().courierId == request.auth.uid
          && ((stage == 'pickup' && deliveryOrder().status in ['courierAssigned','pickedUp','onTheWay'])
            || (stage == 'dropoff' && deliveryOrder().status in ['onTheWay','delivered']))
          && request.resource.data.keys().hasOnly(['courierId','stage','path','createdAt'])
          && request.resource.data.courierId == request.auth.uid && request.resource.data.stage == stage
          && request.resource.data.path == 'delivery_proofs/' + id + '/' + request.auth.uid + '/' + stage + '.jpg'
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }
      match /deliveryIssues/{reportId} {
        function order() { return get(/databases/$(database)/documents/orders/$(id)).data; }
        allow read: if isAdmin() || signedIn() && (order().buyerId == request.auth.uid
          || order().artisanId == request.auth.uid || order().courierId == request.auth.uid);
        allow create: if role('courier') && order().courierId == request.auth.uid
          && order().status in ['courierAssigned','pickedUp','onTheWay']
          && request.resource.data.keys().hasOnly(['courierId','reason','notes','createdAt'])
          && request.resource.data.courierId == request.auth.uid
          && request.resource.data.reason in ['Customer unavailable','Wrong address','Damaged parcel','Unable to accept delivery','Other']
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
          && (request.resource.data.reason != 'Other' || request.resource.data.notes.size() > 0)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /deliveryConfirmations/{orderId} {
      function order() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
      allow get: if signedIn() && order().buyerId == request.auth.uid;
      allow create: if role('buyer') && order().buyerId == request.auth.uid
        && !(order().status in ['delivered','cancelled'])
        && request.resource.data.keys().hasOnly(['code','createdAt'])
        && request.resource.data.code is string && request.resource.data.code.matches('[0-9]{6}')
        && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }

    match /deliveryDevices/{token} {
      allow read: if false;
      allow create, update: if role('courier')
        && request.resource.data.keys().hasOnly(['courierId','token','updatedAt'])
        && request.resource.data.courierId == request.auth.uid
        && request.resource.data.token == token && token.size() <= 2048
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.courierId == request.auth.uid;
    }

    match /artisanProfiles/{id} {
      allow read: if signedIn();
      function fields() { return request.resource.data.keys().hasOnly(['userId','studioName','bio','location','kilnSpecifications','verificationStatus'])
        && request.resource.data.userId == id && request.resource.data.studioName is string
        && request.resource.data.bio is string && request.resource.data.location is string
        && request.resource.data.kilnSpecifications is string; }
      allow create: if owner(id) && role('artisan') && fields() && request.resource.data.verificationStatus == 'pending';
      allow update: if (owner(id) && role('artisan') && fields()
        && request.resource.data.verificationStatus == resource.data.verificationStatus)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus'])
          && request.resource.data.verificationStatus in ['pending','verified','rejected']);
    }
    function deliveredItem(items, id, index) { return index < items.size() && items[index].productId == id; }
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if role('buyer') && reviewEligible(id);
      function reviewEligible(id) {
        let r = request.resource.data;
        let o = get(/databases/$(database)/documents/orders/$(r.orderId)).data;
        return r.keys().hasOnly(['buyerId','artisanId','productId','orderId','rating','comment','createdAt'])
          && r.buyerId == request.auth.uid && o.buyerId == request.auth.uid && o.status == 'delivered'
          && r.artisanId == o.artisanId && id == r.buyerId + '_' + r.orderId + '_' + r.productId
          && r.rating is number && r.rating >= 1 && r.rating <= 5
          && r.comment is string && r.comment.size() > 0 && r.comment.size() <= 2000 && r.createdAt == request.time
          && (deliveredItem(o.items,r.productId,0) || deliveredItem(o.items,r.productId,1)
            || deliveredItem(o.items,r.productId,2) || deliveredItem(o.items,r.productId,3)
            || deliveredItem(o.items,r.productId,4) || deliveredItem(o.items,r.productId,5)
            || deliveredItem(o.items,r.productId,6) || deliveredItem(o.items,r.productId,7));
      }
      allow update, delete: if false;
    }
    match /conversations/{id} {
      function participant() { return signedIn() && request.auth.uid in resource.data.participantIds; }
      allow get: if participant() || (role('buyer') && !exists(/databases/$(database)/documents/conversations/$(id)));
      allow list: if participant();
      allow create: if role('buyer') && request.resource.data.keys().hasOnly(['participantIds','buyerId','artisanId','lastMessage','lastMessageAt','updatedAt'])
        && request.resource.data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.artisanId)).data.role == 'artisan'
        && request.resource.data.participantIds == [request.auth.uid, request.resource.data.artisanId]
        && id == request.auth.uid + '_' + request.resource.data.artisanId
        && request.resource.data.lastMessage == '' && request.resource.data.lastMessageAt == null && request.resource.data.updatedAt == request.time;
      allow update: if participant() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageAt','updatedAt'])
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.lastMessageAt == request.time && request.resource.data.updatedAt == request.time;
      match /messages/{messageId} {
        function member() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds; }
        allow read: if member();
        allow create: if member() && request.resource.data.keys().hasOnly(['senderId','text','createdAt','readAt'])
          && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time && request.resource.data.readAt == null;
        allow update: if member() && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
      }
    }
  }
}
