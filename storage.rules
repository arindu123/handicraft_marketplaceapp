rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product_images/{artisanUid}/{productId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == artisanUid
        && firestore.get(/databases/(default)/documents/users/$(artisanUid)).data.role == 'artisan'
        && (request.resource == null || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
